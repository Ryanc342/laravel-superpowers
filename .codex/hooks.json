{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$(git rev-parse --show-toplevel)/.ai/hooks/check.sh\"",
                        "timeout": 30
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$(git rev-parse --show-toplevel)/.ai/hooks/check.sh\"",
                        "timeout": 600
                    }
                ]
            }
        ]
    }
}
